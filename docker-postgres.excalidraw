      "updated": 1777545024356,
      "link": null,
      "locked": false,
      "text": "docker pull:\n- downloads Dockerfile + entry-point.sh\n- downloads all components defined in Dockerfile\n- creates an <<IMAGE>> file to local Host FS that\nincludes all components defined in Dockerfile:\n  - linux\n  - postgres db server app\n  - entry-point.sh",
      "fontSize": 19.498470738436968,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "docker pull:\n- downloads Dockerfile + entry-point.sh\n- downloads all components defined in Dockerfile\n- creates an <<IMAGE>> file to local Host FS that includes all components defined in Dockerfile:\n  - linux\n  - postgres db server app\n  - entry-point.sh",
      "autoResize": false,
      "lineHeight": 1.25
    },
